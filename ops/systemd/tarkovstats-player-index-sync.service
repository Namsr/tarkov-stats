[Unit]
Description=TarkovStats weekly player nickname index sync
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathExists=/opt/tarkovstats/docker-compose.vps.yml

[Service]
Type=oneshot
WorkingDirectory=/opt/tarkovstats
ExecCondition=/bin/sh -c '! /usr/bin/docker container inspect tarkovstats-public-profile-importer >/dev/null 2>&1'
ExecStart=/usr/bin/flock -n /run/tarkovstats-data-sync.lock /usr/bin/docker compose -f docker-compose.vps.yml exec -T web node --experimental-sqlite scripts/sync-player-index.mjs
TimeoutStartSec=2h
