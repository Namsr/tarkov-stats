[Unit]
Description=Daytime Tarkov profile catch-up after the nightly data cycle

[Timer]
OnCalendar=*-*-* 09..23:00:00 Europe/Moscow
AccuracySec=1s
# Do not replay a missed daytime tick during nightly indexes/publications.
Persistent=false
Unit=tarkovstats-profile-queue.service

[Install]
WantedBy=timers.target
