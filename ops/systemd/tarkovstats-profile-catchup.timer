[Unit]
Description=Temporary daytime Tarkov profile backlog recovery

[Timer]
OnCalendar=*-*-* 09..21:00:00 Europe/Moscow
AccuracySec=1s
# Do not replay a missed daytime tick during nightly indexes/publications.
Persistent=false
Unit=tarkovstats-profile-catchup.service

[Install]
WantedBy=timers.target
