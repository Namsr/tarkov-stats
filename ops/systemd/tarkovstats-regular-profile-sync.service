[Unit]
Description=TarkovStats regular profile feed sync
After=docker.service network-online.target tarkovstats-background.slice
Requires=docker.service tarkovstats-background.slice
Wants=network-online.target
ConditionPathExists=/opt/tarkovstats-auto/docker-compose.vps.yml

[Service]
Type=oneshot
WorkingDirectory=/opt/tarkovstats-auto
# Rollout must remove the legacy daily importer first; never run both writers.
ExecCondition=/bin/sh -c '! /usr/bin/docker container inspect tarkovstats-public-profile-importer >/dev/null 2>&1'
# The worker runner passes `-e` carrying the run budget: the compose service passes no environment, so
# a unit-level Environment= would stop at the docker CLI and never reach the collector.
ExecStart=/usr/bin/flock -n /run/tarkovstats-data-sync.lock /usr/local/sbin/tarkovstats-run-background -e REGULAR_PROFILE_SYNC_MAX_RUN_MS=720000 worker nice -n 19 node --experimental-sqlite scripts/sync-regular-profiles.mjs
# 12 min budget, 2 min short of the window: the collector has to spend its budget
# and then unwind (lease, SQLite, SUMMARY) before systemd kills it. This unit takes
# the shared writer lock at :05, so the part of its 12 min that runs past :15 is
# the wait the blocking seasonal unit at :15 gets - tests/sync-unit-budgets.test.mjs
# holds the two to that sum. The seasonal unit caps its lock wait separately,
# so a Persistent timer catch-up cannot consume its collector's run window.
TimeoutStartSec=14m
TimeoutStopSec=90s
