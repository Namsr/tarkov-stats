[Unit]
Description=TarkovStats Arena profile feed sync
After=docker.service network-online.target tarkovstats-background.slice
Requires=docker.service tarkovstats-background.slice
Wants=network-online.target
ConditionPathExists=/opt/tarkovstats-auto/docker-compose.vps.yml

[Service]
Type=oneshot
WorkingDirectory=/opt/tarkovstats-auto
ExecCondition=/bin/sh -c '! /usr/bin/docker container inspect tarkovstats-public-profile-importer >/dev/null 2>&1'
# The worker runner passes `-e` carrying the run budget: the compose service passes no environment, so
# a unit-level Environment= would stop at the docker CLI and never reach the collector.
ExecStart=/usr/bin/flock -n /run/tarkovstats-data-sync.lock /usr/local/sbin/tarkovstats-run-background -e ARENA_PROFILE_SYNC_RPS=2 -e ARENA_PROFILE_SYNC_MAX_RUN_MS=720000 worker nice -n 19 node --experimental-strip-types --experimental-sqlite scripts/sync-arena-profiles.mjs
# 12 min budget, 2 min short of the window, for the same reason as the other feed
# units. The queue gives this mode 25 min; here the 14m window is the limit, and a
# shorter budget stops the collector cleanly instead of letting systemd cut it.
TimeoutStartSec=14m
TimeoutStopSec=90s
