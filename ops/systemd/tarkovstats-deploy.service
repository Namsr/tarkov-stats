[Unit]
Description=TarkovStats GitHub auto deploy
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
SuccessExitStatus=75
ExecStart=/usr/bin/flock -n -E 75 /run/lock/tarkovstats-deploy.lock /usr/local/sbin/tarkovstats-deploy
TimeoutStartSec=45min
