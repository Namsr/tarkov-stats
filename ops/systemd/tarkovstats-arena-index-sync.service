[Unit]
Description=TarkovStats daily Arena player nickname index sync
After=docker.service network-online.target tarkovstats-background.slice
Requires=docker.service tarkovstats-background.slice
Wants=network-online.target
ConditionPathExists=/opt/tarkovstats-auto/docker-compose.vps.yml

[Service]
Type=oneshot
WorkingDirectory=/opt/tarkovstats-auto
ExecCondition=/bin/sh -c '! /usr/bin/docker container inspect tarkovstats-public-profile-importer >/dev/null 2>&1'
ExecStart=/usr/bin/flock /run/tarkovstats-data-sync.lock /usr/local/sbin/tarkovstats-run-background worker nice -n 19 node --experimental-strip-types --experimental-sqlite scripts/sync-arena-index.mjs
TimeoutStartSec=14h
TimeoutStopSec=90s
