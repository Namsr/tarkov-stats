# Install as /opt/tarkovstats-auto/Caddyfile after reviewing the local config.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_body 10s
			read_header 5s
			write 30s
			idle 120s
		}
		max_header_size 16kb
	}
}

(web_upstream) {
	# Shared across both sites because they use the same upstream address.
	# Reject excess requests with 503 instead of retaining an unbounded queue.
	unhealthy_request_count 32
	# One upstream: do not quarantine both sites after one failed request.
	fail_duration 0
	transport http {
		# Next.js closes idle sockets after 5s; retire pooled sockets first.
		keepalive 4s
		response_header_timeout 20s
		read_timeout 25s
	}
	# Only trusted proxies may supply the original client address.
	header_up X-Real-IP {client_ip}
	header_up X-Request-ID {http.request.uuid}
}

(response_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}
}

(hardening) {
	# Profile access logs include proxy failures and early rejections. Keep only
	# allowlisted identity fields; never log cookies, arbitrary queries or URLs.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				resp_headers delete
			}
		}
	}
	@notProfile not path /api/player/profile
	log_skip @notProfile
	# Query placeholders JOIN repeated values. Capture the first raw value for
	# rejection, so aid=123&aid= stays valid and aid=&aid=123 is rejected.
	map {http.request.uri.query} {profile_first_aid} {
		~(^|&)(a|%61)(i|%69)(d|%64)(=([^&]*))?(&|$) "${6}"
		default ""
	}
	map {query.aid} {profile_aid} {profile_aid_state} {
		"" none empty_or_missing
		~^[[:space:]]*([0-9]{1,15})[[:space:]]*$ "${1}" numeric
		~(?i)^[^,]*players/(regular|pve|arena|pvp-season)/([0-9]{1,15})([/?#][^,]*)?$ "${2}" profile_url
		default none unparsed
	}
	# An unescaped numeric first value remains checkable even with duplicates.
	map {profile_first_aid} {profile_logged_aid} {
		~^([0-9]{1,15})$ "${1}"
		"" none
		default {profile_aid}
	}
	map {query.mode} {profile_mode} {
		"" regular
		regular regular
		pve pve
		arena arena
		seasonal seasonal
		default invalid
	}
	map {query.cycle} {profile_cycle} {
		~^[a-zA-Z0-9-]{1,64}$ "${0}"
		default none
	}
	@profile path /api/player/profile
	log_append @profile event profile_access_v1
	log_append @profile request_id {http.request.uuid}
	log_append @profile aid {profile_logged_aid}
	log_append @profile aid_state {profile_aid_state}
	log_append @profile mode {profile_mode}
	log_append @profile cycle {profile_cycle}
	# Only obviously empty/absent input is rejected here; Next retains complete
	# account validation, including encoded values and supported profile URLs.
	@emptyProfile {
		method GET HEAD
		path /api/player/profile
		expression {profile_first_aid} == ""
	}
	header @emptyProfile {
		Content-Type application/json
		Cache-Control no-store
	}
	respond @emptyProfile `{"error":"Invalid account ID. Paste a numeric id or a tarkov.dev profile link."}` 400
	import response_headers
	# Photo JSON includes base64; all other mutations retain their small body cap.
	@matchPhoto {
		method POST
		path /api/admin/axis-league/match-stats /api/axis-league/match-submission /api/integrations/discord/axis-submission
	}
	request_body @matchPhoto {
		max_size 14MB
	}
	@smallBody {
		not {
			method POST
			path /api/admin/axis-league/match-stats /api/axis-league/match-submission /api/integrations/discord/axis-submission
		}
	}
	request_body @smallBody {
		max_size 256KB
	}
	# These files are never public application routes. Reject scans before Next.
	# Match path segments, including decoded escapes, without blocking .well-known.
	@privateFiles path_regexp privateFiles (?i)(^|/)(\.env([./_-]|$)|\.(git|svn|hg|aws|ssh|terraform)(/|$)|wp-config\.php($|[./])|terraform\.tfstate($|[./])|docker-compose[^/]*\.ya?ml$)
	respond @privateFiles 404
	# Match the first decoded mode value, like URLSearchParams.get(). A plain
	# query matcher would also accept a later mode=arena after mode=pve.
	map {http.request.uri.query} {average_first_mode} {
		~(^|&)(m|%6[dD])(o|%6[fF])(d|%64)(e|%65)(=([^&]*))?(&|$) "${7}"
		default ""
	}
	@arenaAverage {
		path /api/average /api/average/
		expression `{average_first_mode}.matches('^(a|%61)(r|%72)(e|%65)(n|%6[eE])(a|%61)$')`
	}
	reverse_proxy @arenaAverage {$ARENA_UI_UPSTREAM:web:3000} {
		import web_upstream
	}
	@arenaDocument path /population/arena /population/arena/ /average/arena /average/arena/ /_rust/arena/*
	reverse_proxy @arenaDocument {$ARENA_UI_UPSTREAM:web:3000} {
		import web_upstream
	}
	# Select the complete Seasonal endpoint explicitly. The default still uses Next.
	@seasonalCohort path /api/seasonal/cohort /api/seasonal/cohort/
	reverse_proxy @seasonalCohort {$SEASONAL_API_UPSTREAM:web:3000} {
		import web_upstream
	}
	# The public home configuration can move independently of Seasonal.
	@homeShowcase path /api/home/showcase /api/home/showcase/
	reverse_proxy @homeShowcase {$HOME_SHOWCASE_API_UPSTREAM:web:3000} {
		import web_upstream
	}
	reverse_proxy web:3000 {
		import web_upstream
	}
	# Only a refused TCP dial proves the application has not accepted the request.
	# Ordinary overload (503), read resets and timeouts never enter this retry pool.
	handle_errors {
		import response_headers
		@refused expression `{err.status_code} == 502 && {err.message}.matches('^dial tcp .*: (connect: connection refused|connectex: .*actively refused it.*)$')`
		handle @refused {
			@retrySeasonal path /api/seasonal/cohort /api/seasonal/cohort/
			handle @retrySeasonal {
				# A refused Rust dial retries Rust; it never falls back to Next.
				reverse_proxy {$SEASONAL_API_UPSTREAM:web:3000} {
					import web_upstream
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			@retryHomeShowcase path /api/home/showcase /api/home/showcase/
			handle @retryHomeShowcase {
				reverse_proxy {$HOME_SHOWCASE_API_UPSTREAM:web:3000} {
					import web_upstream
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			@retryArenaAverage {
				path /api/average /api/average/
				expression `{average_first_mode}.matches('^(a|%61)(r|%72)(e|%65)(n|%6[eE])(a|%61)$')`
			}
			handle @retryArenaAverage {
				reverse_proxy {$ARENA_UI_UPSTREAM:web:3000} {
					import web_upstream
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			@retryArenaDocument path /population/arena /population/arena/ /average/arena /average/arena/ /_rust/arena/*
			handle @retryArenaDocument {
				reverse_proxy {$ARENA_UI_UPSTREAM:web:3000} {
					import web_upstream
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			handle {
				reverse_proxy web:3000 {
					import web_upstream
					lb_try_duration 4s
					lb_try_interval 100ms
					# Never replay a request after a successful connection, including GET.
					lb_retry_match {
						expression false
					}
				}
			}
		}
		handle {
			respond "" {err.status_code}
		}
	}
}

tarkovstats.ru, www.tarkovstats.ru {
	encode gzip
	import hardening
}

tarkovstats.online, www.tarkovstats.online {
	encode gzip
	import hardening
}
