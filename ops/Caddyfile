# Install as /opt/tarkovstats-auto/Caddyfile after reviewing the local config.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_body 10s
			read_header 5s
			write 30s
			idle 120s
		}
		max_header_size 16kb
	}
}

(web_upstream) {
	# Shared across both sites because they use the same upstream address.
	# Reject excess requests with 503 instead of retaining an unbounded queue.
	unhealthy_request_count {args[0]}
	# One upstream: do not quarantine both sites after one failed request.
	fail_duration 0
	transport http {
		# Next.js closes idle sockets after 5s; retire pooled sockets first.
		keepalive 4s
		response_header_timeout 20s
		read_timeout 25s
	}
	# Only trusted proxies may supply the original client address.
	header_up X-Real-IP {client_ip}
	header_up X-Request-ID {http.request.uuid}
}

(profile_challenge) {
	# Adaptive admission for profile reads. A per-client token bucket answers
	# 429 before Next, and a Turnstile challenge replaces the old blanket 503
	# once the global page rate crosses its limit.
	@profileCheckEndpoint path /__profile-check
	@profileAdmission {
		method GET HEAD
		path /player /player/* /api/player/profile
		not {
			expression {profile_fetch_state} == "missing"
		}
	}
	request_body @profileCheckEndpoint {
		max_size 8KB
	}
	reverse_proxy @profileCheckEndpoint {$PROFILE_CHALLENGE_UPSTREAM:profile-challenge:3119} {
		header_up X-Profile-Client-IP {client_ip}
		transport http {
			dial_timeout 500ms
			response_header_timeout 5s
		}
	}
	forward_auth @profileAdmission {$PROFILE_CHALLENGE_UPSTREAM:profile-challenge:3119} {
		uri /internal/profile-admission
		header_up X-Profile-Client-IP {client_ip}
		transport http {
			dial_timeout 250ms
			response_header_timeout 750ms
		}
	}
}

(response_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}
}

(hardening) {
	# Incident 2026-11-05/06: scraper ranges that ignore robots.txt and keep
	# opening profiles from rotating addresses inside the same allocation.
	@observedScrapers client_ip 57.141.20.0/24 43.172.194.0/24 43.172.195.0/24 43.172.196.0/24 43.172.197.0/24 43.172.198.0/24 43.173.173.0/24 43.173.174.0/24 43.173.175.0/24 43.173.176.0/24 43.173.177.0/24 43.173.178.0/24 43.173.179.0/24 43.173.180.0/24 43.173.181.0/24 43.173.182.0/24
	# Desktop Chrome, Chromium, Edge, Opera and Firefox always send all three
	# Fetch Metadata headers. A copy of their User-Agent without those headers
	# is a scraper. Mobile WebViews stay exempt: older versions omit them.
	map {header.User-Agent} {profile_client_family} {
		~(?i)(bot|crawler|spider|slurp|facebookexternalhit) bot
		~(?i)(headless|playwright|puppeteer|selenium) headless
		~(?i)(android|iphone|ipad|mobile) mobile
		~(?i)(edg(?:e|a|ios)?/|opr/|opera|chromium/|chrome/|firefox/) browser
		default other
	}
	map "{profile_client_family}|{header.Sec-Fetch-Site}|{header.Sec-Fetch-Mode}|{header.Sec-Fetch-User}" {profile_fetch_state} {
		~^(browser|headless)[|][|][|]$ missing
		default present
	}
	# This route runs before the generic redirects and proxies below, so denied
	# requests never reach Next.
	route {
		respond @observedScrapers 403
		@profileScraper {
			method GET HEAD
			path /player /player/* /api/player/profile
			expression {profile_fetch_state} == "missing"
		}
		respond @profileScraper 403
	}
	# Profile access logs include proxy failures and early rejections. Keep only
	# allowlisted identity fields; never log cookies, arbitrary queries or URLs.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				resp_headers delete
			}
		}
	}
	# Opt-in observation on .online only. Keep existing profile API logs on both sites.
	@skipAccess `!path('/api/player/profile') && !('{$PROFILE_BOT_SHADOW:false}' == 'true' && host('tarkovstats.online', 'www.tarkovstats.online') && method('GET') && path('/player', '/player/*') && !header({'RSC':'1', 'Next-Router-Prefetch':'1'}))`
	log_skip @skipAccess
	@profileBotShadow `'{$PROFILE_BOT_SHADOW:false}' == 'true' && host('tarkovstats.online', 'www.tarkovstats.online') && method('GET') && path('/player', '/player/*', '/api/player/profile') && !header({'RSC':'1', 'Next-Router-Prefetch':'1'})`
	map {header.User-Agent} {profile_shadow_agent} {
		~(?i)(bot|crawler|spider|slurp|facebookexternalhit) other
		~(?i)(headless|playwright|puppeteer|selenium) headless
		~(?i)(android|iphone|ipad) other
		~Chrome/(10[3-9]|1[12][0-9]|13[0-3])[.] sampled_chrome
		default other
	}
	map "{profile_shadow_agent}|{header.Sec-Fetch-Site}|{header.Sec-Fetch-Mode}|{header.Sec-Fetch-User}" {profile_shadow_result} {
		~^headless[|] headless
		"sampled_chrome|||" missing_fetch_metadata
		default no_match
	}
	map {path} {profile_shadow_route} {
		~(?i)^/api/player/profile$ profile_api
		default player_page
	}
	log_append @profileBotShadow profile_bot_shadow_v1 {profile_shadow_result}
	log_append @profileBotShadow profile_bot_shadow_route {profile_shadow_route}
	# Query placeholders JOIN repeated values. Capture the first raw value for
	# rejection, so aid=123&aid= stays valid and aid=&aid=123 is rejected.
	map {http.request.uri.query} {profile_first_aid} {
		~(^|&)(a|%61)(i|%69)(d|%64)(=([^&]*))?(&|$) "${6}"
		default ""
	}
	map {query.aid} {profile_aid} {profile_aid_state} {
		"" none empty_or_missing
		~^[[:space:]]*([0-9]{1,15})[[:space:]]*$ "${1}" numeric
		~(?i)^[^,]*players/(regular|pve|arena|pvp-season)/([0-9]{1,15})([/?#][^,]*)?$ "${2}" profile_url
		default none unparsed
	}
	# An unescaped numeric first value remains checkable even with duplicates.
	map {profile_first_aid} {profile_logged_aid} {
		~^([0-9]{1,15})$ "${1}"
		"" none
		default {profile_aid}
	}
	map {query.mode} {profile_mode} {
		"" regular
		regular regular
		pve pve
		arena arena
		seasonal seasonal
		default invalid
	}
	map {query.cycle} {profile_cycle} {
		~^[a-zA-Z0-9-]{1,64}$ "${0}"
		default none
	}
	@profile path /api/player/profile
	log_append @profile event profile_access_v1
	log_append @profile request_id {http.request.uuid}
	log_append @profile aid {profile_logged_aid}
	log_append @profile aid_state {profile_aid_state}
	log_append @profile mode {profile_mode}
	log_append @profile cycle {profile_cycle}
	# Only obviously empty/absent input is rejected here; Next retains complete
	# account validation, including encoded values and supported profile URLs.
	@emptyProfile {
		method GET HEAD
		path /api/player/profile
		expression {profile_first_aid} == ""
	}
	header @emptyProfile {
		Content-Type application/json
		Cache-Control no-store
	}
	respond @emptyProfile `{"error":"Invalid account ID. Paste a numeric id or a tarkov.dev profile link."}` 400
	import response_headers
	# Photo JSON includes base64; all other mutations retain their small body cap.
	@matchPhoto {
		method POST
		path /api/admin/axis-league/match-stats /api/axis-league/match-submission /api/integrations/discord/axis-submission
	}
	request_body @matchPhoto {
		max_size 14MB
	}
	@smallBody {
		not {
			method POST
			path /api/admin/axis-league/match-stats /api/axis-league/match-submission /api/integrations/discord/axis-submission
		}
	}
	request_body @smallBody {
		max_size 256KB
	}
	# These files are never public application routes. Reject scans before Next.
	# Match path segments, including decoded escapes, without blocking .well-known.
	@privateFiles path_regexp privateFiles (?i)(^|/)(\.env([./_-]|$)|\.(git|svn|hg|aws|ssh|terraform)(/|$)|wp-config\.php($|[./])|terraform\.tfstate($|[./])|docker-compose[^/]*\.ya?ml$)
	respond @privateFiles 404
	# Match the first decoded mode value, like URLSearchParams.get(). A plain
	# query matcher would also accept a later mode=arena after mode=pve.
	map {http.request.uri.query} {average_first_mode} {average_mode_state} {
		~(^|&)(m|%6[dD])(o|%6[fF])(d|%64)(e|%65)(=([^&]*))?(&|$) "${7}" present
		default "" missing
	}
	@arenaAverage {
		path /api/average /api/average/
		expression `{average_first_mode}.matches('^(a|%61)(r|%72)(e|%65)(n|%6[eE])(a|%61)$')`
	}
	reverse_proxy @arenaAverage {$ARENA_UI_UPSTREAM:web:3000} {
		import web_upstream 32
	}
	@arenaDocument path /population/arena /population/arena/ /average/arena /average/arena/ /_rust/arena/*
	reverse_proxy @arenaDocument {$ARENA_UI_UPSTREAM:web:3000} {
		import web_upstream 32
	}
	# The population API selector is independent of all page/UI selectors.
	@persistentPopulation {
		path /api/average /api/average/ /api/average/metrics /api/average/metrics/ /api/average/achievements /api/average/achievements/ /api/progression/average /api/progression/average/
		expression `{average_mode_state} == 'missing' || {average_first_mode}.matches('^(p|%70)(v|%76)(e|%65)$') || {average_first_mode}.matches('^(r|%72)(e|%65)(g|%67)(u|%75)(l|%6[cC])(a|%61)(r|%72)$')`
	}
	reverse_proxy @persistentPopulation {$PERSISTENT_POPULATION_API_UPSTREAM:web:3000} {
		import web_upstream 32
	}
	# AXIS aggregate metrics are calculated and served by the Rust HTTP backend.
	@axisStatistics path /api/axis-league/statistics /api/axis-league/statistics/
	reverse_proxy @axisStatistics {$AXIS_STATISTICS_API_UPSTREAM:web:3001} {
		import web_upstream 32
	}
	# Select the complete Seasonal endpoint explicitly. The default still uses Next.
	@seasonalCohort path /api/seasonal/cohort /api/seasonal/cohort/
	reverse_proxy @seasonalCohort {$SEASONAL_API_UPSTREAM:web:3000} {
		import web_upstream 32
	}
	# The public home configuration can move independently of Seasonal.
	@homeShowcase path /api/home/showcase /api/home/showcase/
	reverse_proxy @homeShowcase {$HOME_SHOWCASE_API_UPSTREAM:web:3000} {
		import web_upstream 32
	}
	# Speculative Next.js prefetch shares the real upstream counter, but stops
	# at 8 in-flight requests so it cannot fill all 32 navigation/API slots.
	@nextPrefetch {
		method GET
		header RSC 1
		header Next-Router-Prefetch 1
	}
	reverse_proxy @nextPrefetch web:3000 {
		import web_upstream 8
	}
	# Profile documents and RSC navigation share the same upstream counter.
	# Stop admitting them at 16 so a profile burst leaves half of the 32 slots
	# available for the home page, health checks and API requests.
	@playerPages {
		method GET HEAD
		path /player /player/*
	}
	reverse_proxy @playerPages web:3000 {
		import web_upstream 16
	}
	reverse_proxy web:3000 {
		import web_upstream 32
	}
	# Only a refused TCP dial proves the application has not accepted the request.
	# Ordinary overload (503), read resets and timeouts never enter this retry pool.
	handle_errors {
		import response_headers
		@refused expression `{err.status_code} == 502 && {err.message}.matches('^dial tcp .*: (connect: connection refused|connectex: .*actively refused it.*)$')`
		handle @refused {
			@retrySeasonal path /api/seasonal/cohort /api/seasonal/cohort/
			handle @retrySeasonal {
				# A refused Rust dial retries Rust; it never falls back to Next.
				reverse_proxy {$SEASONAL_API_UPSTREAM:web:3000} {
					import web_upstream 32
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			@retryHomeShowcase path /api/home/showcase /api/home/showcase/
			handle @retryHomeShowcase {
				reverse_proxy {$HOME_SHOWCASE_API_UPSTREAM:web:3000} {
					import web_upstream 32
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			@retryArenaAverage {
				path /api/average /api/average/
				expression `{average_first_mode}.matches('^(a|%61)(r|%72)(e|%65)(n|%6[eE])(a|%61)$')`
			}
			handle @retryArenaAverage {
				reverse_proxy {$ARENA_UI_UPSTREAM:web:3000} {
					import web_upstream 32
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			@retryPersistentPopulation {
				path /api/average /api/average/ /api/average/metrics /api/average/metrics/ /api/average/achievements /api/average/achievements/ /api/progression/average /api/progression/average/
				expression `{average_mode_state} == 'missing' || {average_first_mode}.matches('^(p|%70)(v|%76)(e|%65)$') || {average_first_mode}.matches('^(r|%72)(e|%65)(g|%67)(u|%75)(l|%6[cC])(a|%61)(r|%72)$')`
			}
			handle @retryPersistentPopulation {
				reverse_proxy {$PERSISTENT_POPULATION_API_UPSTREAM:web:3000} {
					import web_upstream 32
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			@retryArenaDocument path /population/arena /population/arena/ /average/arena /average/arena/ /_rust/arena/*
			handle @retryArenaDocument {
				reverse_proxy {$ARENA_UI_UPSTREAM:web:3000} {
					import web_upstream 32
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			handle @nextPrefetch {
				reverse_proxy web:3000 {
					import web_upstream 8
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			handle @playerPages {
				reverse_proxy web:3000 {
					import web_upstream 16
					lb_try_duration 4s
					lb_try_interval 100ms
					lb_retry_match {
						expression false
					}
				}
			}
			handle {
				reverse_proxy web:3000 {
					import web_upstream 32
					lb_try_duration 4s
					lb_try_interval 100ms
					# Never replay a request after a successful connection, including GET.
					lb_retry_match {
						expression false
					}
				}
			}
		}
		handle {
			respond "" {err.status_code}
		}
	}
}

tarkovstats.ru, www.tarkovstats.ru {
	encode gzip
	import hardening
	import profile_challenge
}

tarkovstats.online, www.tarkovstats.online {
	encode gzip
	import hardening
	import profile_challenge
}
