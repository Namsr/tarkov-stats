# Install as /opt/tarkovstats-auto/Caddyfile after reviewing the local config.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_body 10s
			read_header 5s
			write 30s
			idle 120s
		}
		max_header_size 16kb
	}
}

(hardening) {
	# Profile access logs include proxy failures and early rejections. Keep only
	# allowlisted identity fields; never log cookies, arbitrary queries or URLs.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				resp_headers delete
			}
		}
	}
	@notProfile not path /api/player/profile
	log_skip @notProfile
	# Query placeholders JOIN repeated values. Capture the first raw value for
	# rejection, so aid=123&aid= stays valid and aid=&aid=123 is rejected.
	map {http.request.uri.query} {profile_first_aid} {
		~(^|&)(a|%61)(i|%69)(d|%64)(=([^&]*))?(&|$) "${6}"
		default ""
	}
	map {query.aid} {profile_aid} {profile_aid_state} {
		"" none empty_or_missing
		~^[[:space:]]*([0-9]{1,15})[[:space:]]*$ "${1}" numeric
		~(?i)^[^,]*players/(regular|pve|arena|pvp-season)/([0-9]{1,15})([/?#][^,]*)?$ "${2}" profile_url
		default none unparsed
	}
	# An unescaped numeric first value remains checkable even with duplicates.
	map {profile_first_aid} {profile_logged_aid} {
		~^([0-9]{1,15})$ "${1}"
		"" none
		default {profile_aid}
	}
	map {query.mode} {profile_mode} {
		"" regular
		regular regular
		pve pve
		arena arena
		seasonal seasonal
		default invalid
	}
	map {query.cycle} {profile_cycle} {
		~^[a-zA-Z0-9-]{1,64}$ "${0}"
		default none
	}
	@profile path /api/player/profile
	log_append @profile event profile_access_v1
	log_append @profile request_id {http.request.uuid}
	log_append @profile aid {profile_logged_aid}
	log_append @profile aid_state {profile_aid_state}
	log_append @profile mode {profile_mode}
	log_append @profile cycle {profile_cycle}
	# Only obviously empty/absent input is rejected here; Next retains complete
	# account validation, including encoded values and supported profile URLs.
	@emptyProfile {
		method GET HEAD
		path /api/player/profile
		expression {profile_first_aid} == ""
	}
	header @emptyProfile {
		Content-Type application/json
		Cache-Control no-store
	}
	respond @emptyProfile `{"error":"Invalid account ID. Paste a numeric id or a tarkov.dev profile link."}` 400
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}
	request_body {
		max_size 256KB
	}
	# These files are never public application routes. Reject scans before Next.
	# Match path segments, including decoded escapes, without blocking .well-known.
	@privateFiles path_regexp privateFiles (?i)(^|/)(\.env([./_-]|$)|\.(git|svn|hg|aws|ssh|terraform)(/|$)|wp-config\.php($|[./])|terraform\.tfstate($|[./])|docker-compose[^/]*\.ya?ml$)
	respond @privateFiles 404
	reverse_proxy web:3000 {
		# Shared across both sites because they use the same upstream address.
		# Reject excess requests with 503 instead of retaining an unbounded queue.
		unhealthy_request_count 32
		# One upstream: do not quarantine both sites after one failed request.
		fail_duration 0
		transport http {
			response_header_timeout 20s
			read_timeout 25s
		}
		# Only trusted proxies may supply the original client address.
		header_up X-Real-IP {client_ip}
		header_up X-Request-ID {http.request.uuid}
	}
}

tarkovstats.ru, www.tarkovstats.ru {
	encode gzip
	import hardening
}

tarkovstats.online, www.tarkovstats.online {
	encode gzip
	import hardening
}
