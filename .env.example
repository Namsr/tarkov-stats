# Optional local development settings.
# Keep real credentials in .env, which is ignored by Git.

# Local SQLite paths used by the development server.
SQLITE_PATH=./data/players.db
BANS_SQLITE_PATH=./data/bans.db
PROGRESSION_SQLITE_PATH=./data/progression.db
# Rebuildable experimental achievement-speed publication, written by the scheduled worker.
ACHIEVEMENT_TEMPO_SQLITE_PATH=./data/achievement-tempo.db
REPORTS_SQLITE_PATH=./data/community-reports.db
ADMIN_ANALYTICS_SQLITE_PATH=./data/admin-analytics.db
SYSTEM_METRICS_SQLITE_PATH=./data/system-metrics.db
# Separate Bearer token accepted only by the VPS metrics collector.
# At least 32 characters; anything shorter is treated as unset, so the collector
# is refused and the admin dashboard reports it as not configured.
SYSTEM_METRICS_INGEST_TOKEN=

# Optional AXIS Discord screenshot integration. The web API stays disabled until
# the shared secret (at least 32 characters), guild, and channel allowlist are set.
# Put these three settings in web's .env.private AND the bot's .env.discord.
AXIS_DISCORD_SECRET=
AXIS_DISCORD_GUILD_ID=
AXIS_DISCORD_CHANNEL_IDS=
# Bot only: put its token and settings in .env.discord, never in the web env.
DISCORD_TOKEN=
AXIS_DISCORD_API_BASE_URL=http://127.0.0.1:3000
AXIS_DISCORD_STATE_PATH=./data/axis-discord.db
AXIS_DISCORD_LANG=ru
# Optional custom match-start reminder. Empty uses the ru/en dictionary text.
AXIS_DISCORD_REMINDER_TEXT=
# Explicit channel ID -> match number mapping, e.g. {"123456789012345678":1234}.
# Confirmed AXIS chat format: queue-<match number>. Explicit mappings override it.
AXIS_DISCORD_MATCH_CHANNELS={}
AXIS_DISCORD_MATCH_PREFIX=queue-

# Local dev only: serve fabricated average-player data on /average/* so the page
# renders populated without seeding player accounts. Never enable in production.
# LOCAL_FAKE_AVERAGE=1

# Seasonal stays private until explicitly enabled; JSON collection may be
# switched on independently to warm the current cycle's snapshots.
SEASONAL_ENABLED=false
SEASONAL_COLLECTION_SOURCE=operator
SEASONAL_CYCLE_ID=
SEASONAL_STARTS_AT=
SEASONAL_ENDS_AT=
SEASONAL_UPSTREAM_CONTRACT=
SEASONAL_UPSTREAM_FIXTURE_CONFIRMED=false
SEASONAL_PROFILE_UPDATED_URL=https://players.tarkov.dev/pvp-season/updated.json
SEASONAL_PROFILE_INDEX_URL=https://players.tarkov.dev/pvp-season/index.json
SEASONAL_PROFILE_URL_TEMPLATE=https://players.tarkov.dev/pvp-season/{aid}.json

# Opt-in comparison compute, independently per mode. TypeScript remains the default until the
# Rust pilot is measured on the deployment workload. Switch back without a DB migration.
REGULAR_COHORT_BACKEND=typescript
PVE_COHORT_BACKEND=typescript
ARENA_COHORT_BACKEND=typescript
SEASONAL_COHORT_BACKEND=typescript
# HTTP routing is independent of the compute-worker switch. web:3001 opts the
# complete Seasonal cohort endpoint into Rust; recreate both web and Caddy.
SEASONAL_API_UPSTREAM=web:3000
# Optional local native executable override; the Docker image sets its bundled path.
# RUST_COHORT_BIN=/absolute/path/to/tarkov-cohort-worker

# Seasonal population document and data APIs; independent of the cohort-only selector.
SEASONAL_POPULATION_UI_UPSTREAM=web:3000
