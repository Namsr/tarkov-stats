# Optional local development settings.
# Keep real credentials in .env, which is ignored by Git.

# Leave empty to disable Turnstile locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local SQLite paths used by the development server.
SQLITE_PATH=./data/players.db
BANS_SQLITE_PATH=./data/bans.db
PROGRESSION_SQLITE_PATH=./data/progression.db
REPORTS_SQLITE_PATH=./data/community-reports.db
ADMIN_ANALYTICS_SQLITE_PATH=./data/admin-analytics.db
SYSTEM_METRICS_SQLITE_PATH=./data/system-metrics.db
# Separate Bearer token accepted only by the VPS metrics collector.
SYSTEM_METRICS_INGEST_TOKEN=

# Seasonal stays private until explicitly enabled; JSON collection may be
# switched on independently to warm the current cycle's snapshots.
SEASONAL_ENABLED=false
SEASONAL_COLLECTION_SOURCE=operator
SEASONAL_CYCLE_ID=
SEASONAL_STARTS_AT=
SEASONAL_ENDS_AT=
SEASONAL_UPSTREAM_CONTRACT=
SEASONAL_UPSTREAM_FIXTURE_CONFIRMED=false
SEASONAL_PROFILE_UPDATED_URL=https://players.tarkov.dev/pvp-season/updated.json
SEASONAL_PROFILE_INDEX_URL=https://players.tarkov.dev/pvp-season/index.json
SEASONAL_PROFILE_URL_TEMPLATE=https://players.tarkov.dev/pvp-season/{aid}.json

# Dynamic average cache (stale-while-revalidate, 5m TTL + 30m stale).
# Budget caps how long a cold miss blocks the response (default 900ms, max 10s);
# on timeout the API returns 503 + Retry-After:5 and keeps computing in background.
# Stale hits return the last good value immediately with X-Average-Stale:1 (the UI
# shows stale data silently up to 30m, no badge by design).
# Persistent cache is self-hosted node:sqlite only; on Cloudflare/D1 leave empty
# and only the in-memory LRU is used.
# DYNAMIC_AVERAGE_BUDGET_MS=900
# DYNAMIC_AVERAGE_SQLITE_PATH=./data/dynamic-average.db
