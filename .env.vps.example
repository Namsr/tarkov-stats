# Copy this file to `.env` on the VPS and fill in the values.
# `.env` is ignored by git; do not commit real secrets.

# Real Cloudflare Turnstile sitekey. Add tarkovstats.ru / tarkovstats.online
# to the widget's allowed domains in the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAVVIHGZCr2PPwrR

# Google sign-in. Runtime-only; read by the web container through env_file.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site URL without a trailing slash. Caddy proxies to the container over
# the internal Docker network, so this pins the OAuth redirect URI.
PUBLIC_BASE_URL=https://tarkovstats.ru

# Header set by Caddy and trusted by the app for per-IP rate limits.
TRUSTED_IP_HEADER=x-real-ip

# Optional: used by scripts/sync-player-index.mjs when downloading the public
# tarkov.dev nickname index.
PLAYER_INDEX_USER_AGENT=Mozilla/5.0 (compatible; TarkovStatsComparator/0.1; +https://tarkovstats.ru)
