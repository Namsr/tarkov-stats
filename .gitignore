.DS_Store
*.pem
/.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local agent/operator material and deployment runbooks
/.agents/
/.claude/
/.codex/
/.codex-local/
/.cursor/
/.windsurf/
/skills-lock.json
AGENTS.md
CLAUDE.md
GEMINI.md
